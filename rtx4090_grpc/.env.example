# gRPC 门面服务监听地址
GRPC_HOST=127.0.0.1
GRPC_PORT=18500

# gRPC 工作线程数（只做校验与入队，不需要很多）
GRPC_MAX_WORKERS=16

# 作业队列容量
GRPC_QUEUE_SIZE=64

# 是否开启 gRPC 服务反射（方便 grpcurl 调试）
GRPC_REFLECTION=1

# ---------------------------------------------------------------------------
# 产物与下载（新增契约）
# ---------------------------------------------------------------------------
# 契约版本，Health.api_version 暴露给客户端断言
GRPC_API_VERSION=1.0.0
# 产物保留秒数：任务结束后（无论是否 Ack）到期由后台线程统一清理（默认 7 天）
GRPC_RETENTION_SECONDS=604800
# 单任务并发下载流上限
GRPC_MAX_DOWNLOAD_STREAMS=8
# 下载默认块 / 单块上限（字节）
GRPC_DOWNLOAD_CHUNK_BYTES=1048576
GRPC_DOWNLOAD_CHUNK_MAX=4194304
# 磁盘水位保护：剩余字节低于该值时拒绝新任务（默认 2 GiB）
GRPC_MIN_FREE_BYTES=2147483648

# ---------------------------------------------------------------------------
# 引擎配置：留空则回退到 rtx4090/.env 或内置默认值
# ---------------------------------------------------------------------------
# ISAAC_SIM_DIR=/mnt/data/zhouwei/isaacsim
# 物理 nvidia-smi 序号；建议与 HTTP 版错开，避免两个服务抢同一张卡
# ISAAC_GPU=1
# 本服务的产物根目录（默认 <本目录>/state）
# RTX4090_GRPC_STATE_ROOT=/mnt/data/zhouwei/IsaacSim4A100/rtx4090_grpc/state
