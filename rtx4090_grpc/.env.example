# gRPC 门面服务监听地址
GRPC_HOST=127.0.0.1
GRPC_PORT=18500

# gRPC 工作线程数（只做校验与入队，不需要很多）
GRPC_MAX_WORKERS=16

# 作业队列容量
GRPC_QUEUE_SIZE=64

# 是否开启 gRPC 服务反射（方便 grpcurl 调试）
GRPC_REFLECTION=1

# ---------------------------------------------------------------------------
# 引擎配置：留空则回退到 rtx4090/.env 或内置默认值
# ---------------------------------------------------------------------------
# ISAAC_SIM_DIR=/mnt/data/zhouwei/isaacsim
# 物理 nvidia-smi 序号；建议与 HTTP 版错开，避免两个服务抢同一张卡
# ISAAC_GPU=1
# 本服务的产物根目录（默认 <本目录>/state）
# RTX4090_GRPC_STATE_ROOT=/mnt/data/zhouwei/IsaacSim4A100/rtx4090_grpc/state
